# Multi-stage Dockerfile para Frontend Kiosk (Base Debian Bookworm + Nginx)
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copiar configuración de dependencias de frontend
COPY frontend/package*.json ./
RUN npm install

# Copiar código fuente y compilar
COPY frontend/ ./
RUN npm run build

# Etapa 2: Servidor Nginx ligero de producción
FROM nginx:alpine

# Copiar archivos compilados y configuración de proxy
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
