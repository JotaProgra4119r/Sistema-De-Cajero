# Base de Datos MySQL (con fallback transparente a SQLite)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=atm_system
DB_USER=root
DB_PASSWORD=

# API Backend & Seguridad MFA
API_PORT=8000
API_HOST=127.0.0.1
JWT_SECRET=super_secret_jwt_key_here_bank_atm_2026
ALLOW_DEMO_MFA=true

# Hardware Embebido (En Windows: COM3 | En Linux: /dev/ttyUSB0 o /dev/ttyACM0)
