# Persistencia Primaria: Microsoft SQL Server 2022 (sqlserver22 / SQLEXPRESS)
USE_SQLSERVER=true
SQL_SERVER_HOST=127.0.0.1
SQL_SERVER_PORT=1433
SQL_SERVER_INSTANCE=sqlserver22
SQL_SERVER_DB=atm_system
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=

# Base de Datos MySQL (Alternativa Relacional Secundaria)
USE_MYSQL=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=atm_system
DB_USER=root
DB_PASSWORD=

# Red Interbancaria (TCP 5000 / UDP 5005) y Red Multicajero Routers
BANK_CODE=BANC02
BANK_NAME=Banco Nacional Inzano GYT
INTERBANK_TCP_PORT=5000
INTERBANK_UDP_PORT=5005

# API Backend & Seguridad MFA
API_PORT=8000
API_HOST=127.0.0.1
JWT_SECRET=super_secret_jwt_key_here_bank_atm_2026
ALLOW_DEMO_MFA=true

# Hardware Embebido (En Windows: COM3 | En Linux: /dev/ttyUSB0 o /dev/ttyACM0)
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200
ESP32_IP=192.168.1.50
MOCK_HARDWARE=true

# Persistencia Dual en Archivos Planos (.txt)
TXT_STORAGE_PATH=./data/storage_txt/
